{
  "name": "agent-branch-immutability",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [
        "~DEFAULT_BRANCH",
        "refs/heads/release-please--branches--main--components--JameDesktopCommander"
      ],
      "include": ["~ALL"]
    }
  },
  "rules": [
    { "type": "non_fast_forward" }
  ],
  "bypass_actors": []
}
